bootstrap/cache/*.php
.env
.env.backup
docker-compose.override.yml

# NEVER copy the local Vite dev-server marker into the image. If this file
# exists inside the container, Laravel's @vite helper resolves asset URLs
# to http://localhost:5173 (the host's dev server, which doesn't exist in
# the container) and every CSS/JS request 404s, leaving the app unstyled.
public/hot

# The build artefacts are regenerated by `npm run build` inside the
# Dockerfile, so there's no need to ship any stale host copy.
public/build

# Storage symlink is created by `php artisan storage:link` in the entrypoint.
public/storage

APP_NAME="TRIDENT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://probooking.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=probooking
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# File storage disk for driver photos, PO PDFs, licences, POD scans.
#   local  -> /var/www/html/storage/app/private (Docker volume on prod,
#             ephemeral unless app-storage volume is persisted -- FINE for
#             dev/local, DO NOT use on prod without an off-site backup).
#   r2     -> Cloudflare R2. Requires R2_* keys below. Recommended for prod.
#   s3     -> Amazon S3. Requires AWS_* keys below.
# Files "remember" the disk they were written to (job_documents.disk), so
# swapping this on prod does not break previously-uploaded files.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tcdc.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Amazon S3 (only populated if FILESYSTEM_DISK=s3) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Cloudflare R2 (primary production disk) ----
# Where to get these:
#   https://dash.cloudflare.com/ -> R2 -> Overview -> Manage R2 API Tokens
# Create a token with "Object Read & Write" scope limited to your bucket.
# R2_ENDPOINT is the "Account endpoint" shown on the bucket page, with the
# form https://<account-id>.r2.cloudflarestorage.com (NO trailing slash,
# NO bucket name appended).
# Verify after deploy: `php artisan storage:check --disk=r2`
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

# ---- Cloudflare R2 BACKUP (database dumps only) ----
# Separate bucket + separate API token so a compromised primary storage
# key cannot destroy the backups. Used by `php artisan backup:database`
# and `backup:cleanup` scheduled jobs.
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
R2_BACKUP_ENDPOINT=
R2_BACKUP_REGION=auto

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=changeme
SUPER_ADMIN_NAME="System Admin"

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=

# Base URL used for public verification links in collection-note QR codes.
# Leave blank to use APP_URL. Set e.g. https://tcdc.co.za during cutovers.
COLLECTION_NOTE_PUBLIC_URL=

# Auto-link transport jobs to per-chassis inventory rows via JobObserver.
# Default false: the inventory table exists but nothing writes to it from
# the dispatch flow. Flip to true only after you're ready to backfill /
# manage inventory rows properly. Safe to toggle per environment.
INVENTORY_LINK_ENABLED=false
